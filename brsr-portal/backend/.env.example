# ============================================
# BRSR PORTAL BACKEND ENVIRONMENT VARIABLES
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5101
FRONTEND_URL=http://localhost:3100

# Database — SAME database as the main SustainSutra app so existing
# BRSR report documents and user accounts keep working unchanged.
MONGO_URI=mongodb://127.0.0.1:27017/sustainsutra

# JWT — must MATCH the main backend's JWT_SECRET so the same user
# accounts (cookie tokens) are valid here.
JWT_SECRET=change_me
JWT_EXPIRE=30d

# Demo mode (fail-closed in production)
DEMO_MODE=false

# Email (used by user routes for password reset)
EMAIL_FROM=noreply@sustainsutra.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
