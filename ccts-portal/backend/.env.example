# ============================================
# CCTS PORTAL BACKEND ENVIRONMENT VARIABLES
# ============================================

NODE_ENV=development
PORT=5201
FRONTEND_URL=http://localhost:3200

# Database — SAME database as the main SustainSutra app so existing CCTS
# entities, monitoring data and user accounts keep working unchanged.
MONGO_URI=mongodb://127.0.0.1:27017/sustainsutra

# JWT — must MATCH the main backend's JWT_SECRET so the same user
# accounts (cookie tokens) are valid here.
JWT_SECRET=change_me
JWT_EXPIRE=30d

DEMO_MODE=false

EMAIL_FROM=noreply@sustainsutra.in
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
