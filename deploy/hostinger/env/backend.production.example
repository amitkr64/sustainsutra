# ==========================================================
# SustainSutra MAIN BACKEND — PRODUCTION ENVIRONMENT
# Copy to backend/.env on the server and fill in real values.
# ==========================================================

NODE_ENV=production
PORT=5000

# Your public site URL (used for sitemap links, CORS, emails)
SITE_URL=https://sustainsutra.in
FRONTEND_URL=https://sustainsutra.in

# Database — MongoDB Atlas (free M0 tier is fine to start):
# https://cloud.mongodb.com  →  Create cluster → Database Access user →
# Network Access: add the VPS IP (or 0.0.0.0/0) → Get connection string.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/sustainsutra?retryWrites=true&w=majority

# JWT — REQUIRED. Generate with:  openssl rand -base64 64
# Use the SAME value in brsr-portal/backend/.env and ccts-portal/backend/.env
# so one login works across the main site and both portals.
JWT_SECRET=GENERATE_A_STRONG_SECRET
JWT_EXPIRE=30d

# Must be false in production (the server refuses to start otherwise)
DEMO_MODE=false

# Email (transactional — password resets, notifications).
# Hostinger email accounts work: smtp.hostinger.com, port 465.
EMAIL_FROM=noreply@sustainsutra.in
EMAIL_FROM_NAME=SustainSutra GreenTech LLP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@sustainsutra.in
SMTP_PASS=YOUR_EMAIL_PASSWORD

# Payments (optional — the Academy checkout needs these)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend build-time vars (only needed if building on the server;
# leave VITE_API_URL EMPTY for same-domain hosting behind nginx)
# VITE_API_URL=https://api.sustainsutra.in
